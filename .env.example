# Raku Twitch Bot
NODE_ENV=development
HOST=0.0.0.0
PORT=3210

# Local storage
DATA_DIR=../../data

# Twitch Developer Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch users (numeric Twitch IDs)
TWITCH_BROADCASTER_ID=
TWITCH_BOT_USER_ID=

# OAuth token handling will be wired into the dashboard.
# Keep tokens out of Git and never commit a real .env file.
TWITCH_ACCESS_TOKEN=
